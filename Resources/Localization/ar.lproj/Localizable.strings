// Blackout
"Blackout Now" = "تعتيم الشاشة الآن";
"Settings…" = "الإعدادات…";
"Quit Blackout" = "إنهاء Blackout";
"Edit" = "تحرير";
"Cut" = "قص";
"Copy" = "نسخ";
"Paste" = "لصق";
"Select All" = "تحديد الكل";
"Shortcut: ⌃⌥B" = "الاختصار: ⌃⌥B";
"Blackout — %d display(s) detected" = "Blackout — تم اكتشاف %d شاشة";
"Unlock Blackout" = "فتح قفل Blackout";
"Password" = "كلمة السر";
"Unlock password" = "كلمة سر فتح القفل";
"Enter your password to restore the screen." = "أدخل كلمة السر لاستعادة الشاشة.";
"Unlock" = "فتح القفل";
"Cancel" = "إلغاء";
"Incorrect password. Please wait a moment and try again." = "كلمة السر غير صحيحة. انتظر قليلًا ثم حاول مجددًا.";
"Could not register ⌃⌥B (error %d). Another app may already use that shortcut." = "تعذّر تسجيل ⌃⌥B (الخطأ %d). ربما يستخدم تطبيق آخر هذا الاختصار بالفعل.";
"Enter a password (up to 1,024 UTF-8 bytes)." = "أدخل كلمة سر (حتى 1,024 بايت بترميز UTF-8).";
"The new passwords do not match." = "كلمتا السر الجديدتان غير متطابقتين.";
"The current password is incorrect." = "كلمة السر الحالية غير صحيحة.";
"The saved password settings could not be read. See the recovery instructions in the README." = "تعذّرت قراءة إعدادات كلمة السر المحفوظة. راجع إرشادات الاسترداد في README.";
"The password could not be processed. Please try again." = "تعذّرت معالجة كلمة السر. حاول مجددًا.";
"Input blocking requires permission to control keyboard and mouse input. Open System Settings and enable Blackout, then try again." = "يتطلب حظر الإدخال إذنًا للتحكم في إدخال لوحة المفاتيح والماوس. افتح إعدادات النظام واسمح لـ Blackout، ثم حاول مجددًا. إذا كان Blackout مسموحًا بالفعل، فأزله من القائمة، وأضف التطبيق المثبّت حاليًا مرة أخرى، ثم أعد تشغيل Blackout.";
"Input blocking could not start. The screen has not been covered." = "تعذّر بدء حظر الإدخال. لم تتم تغطية الشاشة.";
"Input blocking stopped. Blackout has ended to avoid hiding another app while input is unprotected." = "توقف حظر الإدخال. انتهى التعتيم لتجنب إخفاء تطبيق آخر أثناء عدم حماية الإدخال.";
"Open System Settings" = "فتح إعدادات النظام";
"Blackout Settings" = "إعدادات Blackout";
"Language" = "اللغة";
"System Default" = "اللغة الافتراضية للنظام";
"Launch at login" = "فتح عند تسجيل الدخول";
"Open Login Settings…" = "فتح إعدادات تسجيل الدخول…";
"Require a password to restore the screen" = "طلب كلمة سر لاستعادة الشاشة";
"Current password (required to change or disable)" = "كلمة السر الحالية (للتغيير أو التعطيل)";
"New password" = "كلمة سر جديدة";
"Confirm new password" = "تأكيد كلمة السر الجديدة";
"Save Password Settings" = "حفظ إعدادات كلمة السر";
"Password protection is optional. Blackout covers the screen within the app and does not replace the macOS screen lock." = "الحماية بكلمة سر اختيارية. يغطي Blackout الشاشة من داخل التطبيق ولا يحل محل قفل شاشة macOS.";
"Password protection is on." = "الحماية بكلمة سر مفعّلة.";
"Password protection is off." = "الحماية بكلمة سر معطّلة.";
"Saved. A password will be required the next time you black out the screen." = "تم الحفظ. ستُطلب كلمة سر عند تعتيم الشاشة في المرة القادمة.";
"Saved. Password protection is off." = "تم الحفظ. الحماية بكلمة سر معطّلة.";
"Blackout will run in the menu bar when you log in." = "سيعمل Blackout في شريط القوائم عند تسجيل الدخول.";
"Allow Blackout in the macOS login settings." = "اسمح لـ Blackout في إعدادات تسجيل الدخول في macOS.";
"Launch at login is off." = "الفتح عند تسجيل الدخول معطّل.";
"Blackout is not registered as a login item. Enable the option to register it." = "لم يُسجّل Blackout كعنصر دخول. فعّل الخيار لتسجيله.";
"Check the status in the macOS login settings." = "تحقق من الحالة في إعدادات تسجيل الدخول في macOS.";
"Could not change launch at login: %@" = "تعذّر تغيير الفتح عند تسجيل الدخول: %@";
"Input Blocking" = "حظر الإدخال";
"Open Input Permission Settings…" = "فتح إعدادات إذن الإدخال…";
"Input control permission is enabled. Keyboard and mouse input can be blocked during blackout." = "إذن التحكم في الإدخال مفعّل. يمكن حظر إدخال لوحة المفاتيح والماوس أثناء التعتيم.";
"Input control permission is required before blackout. Open the permission settings below and enable Blackout." = "يلزم إذن التحكم في الإدخال قبل التعتيم. افتح إعدادات الأذونات أدناه واسمح لـ Blackout. إذا كان Blackout مسموحًا بالفعل، فأزله من القائمة، وأضف التطبيق المثبّت حاليًا مرة أخرى، ثم أعد تشغيل Blackout.";

"Version %@" = "الإصدار %@";
"Check for Updates…" = "التحقق من وجود تحديثات…";
"Checking for updates…" = "جارٍ التحقق من وجود تحديثات…";
"You’re up to date." = "لديك أحدث إصدار.";
"Version %@ is available." = "الإصدار %@ متاح.";
"No releases have been published yet." = "لم تُنشر أي إصدارات بعد.";
"Could not check for updates. Please try again." = "تعذّر التحقق من وجود تحديثات. حاول مجددًا.";
"Open Release Page…" = "فتح صفحة الإصدار…";

